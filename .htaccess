# InfinityFree: keep Laravel source files outside the public URL space.
Options -Indexes
RewriteEngine On

# Do not rewrite requests that are already inside public/.
RewriteRule ^public/ - [L]

# Optional Laravel public-disk uploads (symlinks are not available on InfinityFree).
RewriteRule ^storage/(.*)$ storage/app/public/$1 [L]

# Serve all remaining requests through Laravel's public directory.
RewriteRule ^(.*)$ public/$1 [L]
