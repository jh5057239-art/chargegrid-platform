# InfinityFree serves htdocs as the document root; route Laravel through public/.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Map public-disk files without requiring symlinks.
    RewriteRule ^storage/(.*)$ /storage/app/public/$1 [END]

    # Send all other requests to Laravel's public directory.
    RewriteRule (.*) /public/$1 [L]
</IfModule>
