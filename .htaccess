# InfinityFree keeps htdocs as the document root. Keep Laravel's app files behind public/.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Do not rewrite a request a second time after it has entered public/.
    RewriteCond %{REQUEST_URI} !^/public/ [NC]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Prevent directory listings and direct access to private project files if rewrite is unavailable.
Options -Indexes
